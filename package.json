{
  "name": "play-kit",
  "version": "1.0.0",
  "description": "A comprehensive, production-ready 3D development library that transforms complex 3D graphics programming into intuitive, composable React components.",
  "keywords": [
    "3d",
    "react",
    "threejs",
    "game-development",
    "graphics",
    "components"
  ],
  "homepage": "https://github.com/girish-kor/play-kit#readme",
  "bugs": {
    "url": "https://github.com/girish-kor/play-kit/issues"
  },
  "license": "MIT",
  "author": "Girish Kor <your.email@example.com>",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "ci": "npm run format && npm run lint && npm run build"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=17.0.0",
    "three": ">=0.150.0"
  },
  "dependencies": {
    "react": ">=17.0.0",
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.2",
    "@react-three/fiber": "^8.15.11",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/react": "^18.2.37",
    "@types/three": "^0.157.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rollup": "^4.5.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/girish-kor/play-kit.git"
  }
}
